# Supabase (Project Settings > API). A chave anon é pública; a service_role é SECRETA.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (Vercel) e no seu computador para `npm run seed`. Nunca com o prefixo NEXT_PUBLIC_, nunca no Git.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo longo e aleatório (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Assina o cookie de eleitor e salga os hashes. Trocá-lo invalida os cookies já emitidos.
VOTE_HASH_SECRET=
# Cloudflare Turnstile. A chave do site é pública e embutida no build; a secreta fica só no servidor.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Endereço público do site (sitemap, canonical, Open Graph). Ex.: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=
# E-mail de contato exibido em /privacidade (direitos de titular da LGPD). Sem ele, a página aponta para /corrigir.
NEXT_PUBLIC_CONTACT_EMAIL=
# Segredo do cron de limpeza (/api/cron/purge). A Vercel o envia como "Authorization: Bearer ...".
CRON_SECRET=
# Data de abertura da votação, ISO 8601 com fuso. Ex.: 2026-12-01T00:00:00-03:00
# Sem o "-03:00" o horário seria lido no fuso do servidor (UTC na Vercel). Vazio = aberta desde já. A votação fecha sozinha em 12/12/2026 00:00 (Brasília).
VOTING_OPENS_AT=

# Somente para testes (não são lidas pelo site): ver README.md e e2e/admin.spec.ts.
# E2E_BASE_URL=http://localhost:3000
